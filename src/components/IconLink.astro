---
// A link with a small one-color logo in front when it points to arXiv, Hugging Face, GitHub,
// Google Scholar, LinkedIn or an email address.
import Logo from "./Logo.astro";

interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
const url = new URL(href, "https://quq99.github.io");
const host = url.hostname;
const icon =
  url.protocol === "mailto:"
    ? "mail"
    : host.endsWith("arxiv.org")
      ? "arxiv"
      : host.endsWith("huggingface.co")
        ? "huggingface"
        : host === "github.com"
          ? "github"
          : host === "scholar.google.com"
            ? "scholar"
            : host.endsWith("linkedin.com")
              ? "linkedin"
              : null;
---

<a href={href} class="inline-flex items-center gap-[0.4em]">
  {icon && <Logo name={icon} size="0.9em" />}
  <span>{label}</span>
</a>
