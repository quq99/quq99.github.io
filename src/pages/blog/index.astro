---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<Base title="Writing" description="Notes by Qian Qu on Vim, C++ and putting models on phones (2019).">
  <section class="shell pt-16 pb-28 sm:pt-24 md:pt-32" aria-labelledby="title">
    <div class="row">
      <div aria-hidden="true"></div>
      <div>
        <h1 id="title" class="text-[2.25rem] leading-[1.08] font-semibold tracking-[-0.03em] sm:text-[3rem]">Writing</h1>
        <p class="mt-4 max-w-[34rem] text-lg text-ink-2 tracking-[-0.016em]">
          Notes from 2019, written while I learned Vim, C++ and how to put models on phones. Kept as an archive.
        </p>
      </div>
    </div>
    <ol class="mt-14 space-y-9 sm:mt-20">
      {
        posts.map((post) => (
          <li class="row">
            <p class="label num">{fmt(post.data.date)}</p>
            <div>
              <h2 class="font-semibold">
                <a href={`/blog/${post.id}/`} class="text-ink no-underline hover:text-seal">{post.data.title}</a>
              </h2>
              <p class="mt-1 text-ink-2">{post.data.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
